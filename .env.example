POSTGRES_USER=platform_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortage_platform
INGESTION_DB_PASSWORD=change-me
READONLY_DB_PASSWORD=change-me
DATABASE_URL_OWNER=postgresql+psycopg://platform_owner:change-me@127.0.0.1:5432/shortage_platform
DATABASE_URL=postgresql+psycopg://ingestion_app:change-me@127.0.0.1:5432/shortage_platform
# Read-only role the agents' data source (PostgresData) connects as
DATABASE_URL_READONLY=postgresql+psycopg://readonly_app:change-me@127.0.0.1:5432/shortage_platform

# Amazon Bedrock (agents)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
BEDROCK_MODEL_ID=

# Health Product Shortages Canada API (https://healthproductshortages.ca/blog/52)
SHORTAGE_API_BASE_URL=https://healthproductshortages.ca/api/v1
SHORTAGE_API_EMAIL=
SHORTAGE_API_PASSWORD=

# Where the agents read stock, orders and drugs: csv (mock/, default) or postgres (DATABASE_URL_READONLY)
AGENT_DATA_SOURCE=csv
